# Vercel Ignore File
# Exclude large source files not needed for production build
*.xlsx
*.txt
*.json
!package.json
!tsconfig.json
!next.config.ts
!src/**/*.json
!public/**/*.json

# Exclude large documentation/backup files
*.md
!README.md
__mocks__
__nitter.txt
check_reset_time.py
cleanup-quotes.js
extract_weapon_stats.js
generate_weapons_data.js
inspect_formulas.py
read_excel_summary.py
test-conditions.js
temp_demon_wedges_backup.ts

# Exclude test files
jest.config.js
jest.setup.js
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Exclude git
.git
.gitignore

# Exclude dev tools
.idx
.kiro
.vscode
