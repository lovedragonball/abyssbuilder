# Environment Variables Example
# Copy this file to .env.local and fill in your values

# App Configuration
NEXT_PUBLIC_APP_NAME=AbyssBuilds
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false

# Storage Configuration
NEXT_PUBLIC_STORAGE_PREFIX=abyssbuilds_

# Social Media Configuration
NEXT_PUBLIC_FACEBOOK_PAGE_URL=https://www.facebook.com/DNAbyss.Official
NEXT_PUBLIC_FACEBOOK_MOBILE_URL=https://m.facebook.com/DNAbyss.Official
# NEXT_PUBLIC_FACEBOOK_VIDEO_URL=https://www.facebook.com/DNAbyss.Official/videos/123456789

# Future: API Configuration (when backend is added)
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_API_KEY=your_api_key_here
