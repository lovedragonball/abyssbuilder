  "introns": [
    {
      "id": 1,
      "description": "Upon using Helix Leap or [Faintlight], Berenica gains 1 stack that increases Skill Efficiency by 8% for 12s, up to 3 stacks.",
      "note": "Lower her Ult sanity from 23/s (including her talent) to 17.5/s, which is a big help in maintaining her ultimate stance. Very good, but requires either the frequent use of her Helix Leap or Skill (which consumes sanity unless it is the first use after entering her ultimate)."
    },
    {
      "id": 2,
      "description": "Increase damage dealt to targets with a HP Percentage lower than Berenica by 30%."
    },
    {
      "id": 3,
      "description": "[Faintlight] Level +2; [Recuperation] Level +1;"
    },
    {
      "id": 4,
      "description": "Increase Berenica's Attack by 20% per Combo Level",
      "note": "Optimally we want to stay in her ultimate most of the time, so we don't get to build many Combo Levels."
    },
    {
      "id": 5,
      "description": "[Netherflames] Level +2; [Recuperation] Level +1;",
      "note": "Increases Ultimate Level and hence her primary source of damage."
    },
    {
      "id": 6,
      "description": "When in [Netherflames] state, each attack has a chance to unleash 1 additional Swordwave. The probability equals to 25% of [Ymir]'s Trigger Probability.",
      "note": "Effectively +1 Attack every 4 hits on average. depending on her current Hit-State, this can be very good or less so."
    }
  ]
